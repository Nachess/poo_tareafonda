<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>cl.dsy1102</groupId>
    <artifactId>fonda-san-belarmino</artifactId>
    <version>2.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Fonda San Belarmino</name>
    <description>
        Tarea Fiestas Patrias - DSY1102 Programacion Orientada a Objetos.
        EA2: Desarrollo de interfaces graficas con persistencia en archivo.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Version de Java del proyecto. Si tu laboratorio tiene JDK 25, cambia
             este valor a 25 y la version de JavaFX a 25.0.1. -->
        <maven.compiler.release>21</maven.compiler.release>

        <!-- Clase de consola de EA1, se ejecuta con: mvn compile exec:java -->
        <exec.mainClass>cl.dsy1102.fonda.Main</exec.mainClass>

        <javafx.version>21.0.6</javafx.version>
        <jackson.version>2.21.4</jackson.version>
    </properties>

    <dependencies>
        <!-- Interfaz grafica (EA2) -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Persistencia en JSON (EA2) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!-- Copia los FXML, CSS y demas recursos de src/main/resources -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>

            <!-- Programa de consola de EA1: mvn compile exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>${exec.mainClass}</mainClass>
                </configuration>
            </plugin>

            <!-- Aplicacion JavaFX de EA2: mvn javafx:run
                 Como el proyecto tiene module-info.java, la clase se indica
                 con el formato modulo/clase. -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>cl.dsy1102.fonda/cl.dsy1102.fonda.AppFX</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
